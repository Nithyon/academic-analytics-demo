{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run demo (opens browser)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Backend only (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Regenerate synthetic data (seed 7)",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.data_generator",
      "args": ["--seed", "7"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run benchmark in terminal",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.evaluation",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
